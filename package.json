{
  "name": "devpilot-2026-monorepo",
  "version": "0.1.0",
  "private": true,
  "packageManager": "npm@10.5.0",
  "workspaces": [
    "gateway",
    "auth-service",
    "projects-service",
    "frontend/*"
  ],
  "engines": {
    "node": ">=18.18"
  },
  "scripts": {
    "bootstrap": "npm install --workspaces",
    "dev:backend": "echo \"run gateway, auth-service, projects-service separately\"",
    "dev:frontend": "echo \"start shell and remotes via npm run dev in each frontend workspace\"",
    "lint": "echo \"add package-specific lint scripts\""
  }
}
